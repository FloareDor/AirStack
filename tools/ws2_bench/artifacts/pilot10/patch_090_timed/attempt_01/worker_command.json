[
  "docker",
  "run",
  "--rm",
  "--name",
  "ws2-episode-worker",
  "--gpus",
  "all",
  "--ipc=host",
  "--network",
  "airstack_airstack_network",
  "-v",
  "/root/MonoNav:/workspace/planner",
  "-w",
  "/workspace/planner",
  "-v",
  "/root/AirStack/robot/ros_ws/ws2_runtime/inference:/ws2_inference",
  "-e",
  "WS2_INFERENCE_DIR=/ws2_inference",
  "-e",
  "WS2_RUN_ID=/root/AirStack/robot/ros_ws/ws2_runtime/campaigns/patch_090_timed/attempt_01",
  "-v",
  "mononav-torch-cache:/root/.cache/torch",
  "mononav-demo:2.7.1-cu128",
  "python",
  "-u",
  "mononav_airstack.py",
  "--headless",
  "--execute",
  "--server",
  "http://airstack-robot-desktop-1:8765",
  "--depth-source",
  "zoe",
